rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin role: a signed-in user is an admin if a document exists at
    // admins/{uid}. Admin documents are created from the Firebase console
    // or the Admin SDK; clients cannot write them.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // A user may only read their own admin document (used for the role check).
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /cafes/{cafeId} {

      // Anyone can read the menu, tables and orders.
      allow read: if true;

      match /categories/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /menuItems/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /tables/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /orders/{doc} {
        // Customers can place and read orders.
        allow create, read: if true;
        // Only admins can change the status or delete an order.
        allow update, delete: if isAdmin();
      }

      match /calls/{doc} {
        // Customers create a call when they press "call staff".
        allow create, read: if true;
        // Only admins can mark a call as handled or delete it.
        allow update, delete: if isAdmin();
      }

    }
  }
}
