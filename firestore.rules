rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Staff roles come from Firebase Auth custom claims, which only the
    // Admin SDK can set (see tools/set_staff_role). Never trust an email.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function isStaff() {
      return isAdmin() || (isSignedIn() && request.auth.token.get('kitchen', false) == true);
    }

    function validOrderItem(item) {
      return item is map
        && item.keys().hasOnly(['menuItemId', 'name', 'quantity', 'price'])
        && item.menuItemId is string
        && item.name is string && item.name.size() <= 100
        && item.quantity is int && item.quantity > 0 && item.quantity <= 99
        && item.price is number && item.price >= 0;
    }

    // Guests place orders anonymously from the table QR code, so creation is
    // open, but only in the initial `pending` state with a well-formed body.
    function validNewOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['orderNumber', 'orderType', 'tableName',
                               'tableNumber', 'items', 'total', 'status', 'createdAt'])
        && d.status == 'pending'
        && d.orderNumber is string && d.orderNumber.size() <= 32
        && d.orderType is string && d.orderType.size() <= 32
        && d.tableName is string && d.tableName.size() <= 64
        && d.tableNumber is int && d.tableNumber >= 0
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && validOrderItem(d.items[0])
        && d.total is number && d.total >= 0
        && d.createdAt is timestamp;
    }

    // A guest may only cancel an order that the kitchen has not started yet.
    function isGuestCancel() {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    function validNewCall() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tableNumber', 'status', 'createdAt'])
        && d.tableNumber is int && d.tableNumber >= 0
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    match /cafes/{cafeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /categories/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /menuItems/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /tables/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /ingredients/{doc} {
        allow read, write: if isAdmin();
      }

      match /orders/{doc} {
        allow read: if true;
        allow create: if validNewOrder();
        allow update: if isStaff() || isGuestCancel();
        allow delete: if isAdmin();
      }

      match /calls/{doc} {
        allow read: if true;
        allow create: if validNewCall();
        allow update, delete: if isStaff();
      }
    }
  }
}
